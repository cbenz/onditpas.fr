---
import Proposer from '../components/Proposer.astro';
import '../styles/global.css';

interface Props {
  /** Document title, without the site suffix. */
  title: string;
  description?: string;
  /** Where the wordmark points; `null` renders it as plain text (on the mur). */
  wordmarkHref?: string | null;
  /** Whether the header links to the mur de mots. */
  murLink?: boolean;
  /** Whether the contribution control is shown. On by default, on every page. */
  proposer?: boolean;
  /** Pre-fills the forme fautive, e.g. with the word of a generated fiche. */
  proposerPrefill?: string;
  /** A selector for the element that holds the forme fautive, for pages that fill it client-side. */
  proposerPrefillFrom?: string;
  /**
   * Keep the document out of search engines. Generated fiches and utility
   * routes are one document serving infinite URLs; they must not be indexed.
   */
  noindex?: boolean;
  /**
   * The canonical URL. `null` omits the tag: a generated fiche is one document
   * served for every unknown slug, so it has no address of its own to claim.
   */
  canonical?: string | null;
}

const {
  title,
  description,
  wordmarkHref = '/',
  murLink = true,
  noindex = false,
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://onditpas.fr').href,
  proposer = true,
  proposerPrefill,
  proposerPrefillFrom,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="preload"
      href="/fonts/anton-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="page">
      <header class="top">
        {
          wordmarkHref ? (
            <a class="wordmark" href={wordmarkHref}>onditpas.fr</a>
          ) : (
            <span class="wordmark">onditpas.fr</span>
          )
        }
        {murLink && <a class="mur-link" href="/">toutes les fiches</a>}
      </header>
      <main>
        <slot />
      </main>
    </div>
    {proposer && <Proposer formeFautive={proposerPrefill} prefillFrom={proposerPrefillFrom} />}
  </body>
</html>
