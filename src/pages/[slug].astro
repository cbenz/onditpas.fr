---
import { getCollection, render } from 'astro:content';

import Fiche from '../components/Fiche.astro';
import Base from '../layouts/Base.astro';
import { excerpt } from '../lib/excerpt';
import { editUrl } from '../lib/github';
import { slugify } from '../lib/slug';

export async function getStaticPaths() {
  const fiches = await getCollection('fiches');
  return fiches.map((fiche) => ({
    params: { slug: slugify(fiche.data.forme_fautive) },
    props: { fiche },
  }));
}

const { fiche } = Astro.props;
const { Content } = await render(fiche);
const { forme_fautive, forme_correcte } = fiche.data;
const slug = slugify(forme_fautive);

const pageTitle = forme_correcte
  ? `${forme_fautive} — on dit ${forme_correcte} · onditpas.fr`
  : `${forme_fautive} · onditpas.fr`;

const description = fiche.data.justification ?? excerpt(fiche.body ?? '');
---

<Base title={pageTitle} description={description}>
  <Fiche
    formeFautive={forme_fautive}
    formeCorrecte={forme_correcte}
    justification={fiche.data.justification}
    sources={fiche.data.sources}
    editUrl={editUrl(fiche.filePath)}
    shoutHref={`/${slug}/bordel`}
  >
    <Content />
  </Fiche>
</Base>
