---
/**
 * The fiche, variant A ("Dictionnaire").
 *
 * Pure presentation: it takes the data of one fiche and the registre to render
 * it in, so that the deadpan page and the shouting page (ticket #6) share the
 * same component. The definition arrives through the default slot.
 */
import { hostOf } from '../lib/host';
import { registreLabel, type Registre } from '../lib/registre';
import { NBSP } from '../lib/typography';

export interface Props {
  /** The form people wrongly write, set as the headline. */
  formeFautive: string;
  /** What should be said instead; absent when the fiche has no substitute. */
  formeCorrecte?: string;
  /** Why there is nothing to substitute; shown under the correction line. */
  justification?: string;
  /** URLs backing the correction. */
  sources?: string[];
  registre?: Registre;
  /**
   * Overrides the correction line, e.g. the generated shouting title
   * (`ON DIT PUBLIC, PAS PUBLIQUE, BORDEL !`). Defaults to the forme correcte.
   */
  correction?: string;
  /** GitHub's edit form for this fiche's own file, built by the page. */
  editUrl?: string;
  /**
   * The shouting version of the same fiche, offered as a way to send it
   * harder. Absent on the shouting page, which is already there.
   */
  shoutHref?: string;
}

const {
  formeFautive,
  formeCorrecte,
  justification,
  sources = [],
  registre = 'deadpan',
  correction,
  editUrl,
  shoutHref,
} = Astro.props;

const label = registreLabel(registre);
const correctionText = correction ?? formeCorrecte;
---

<article class:list={['fiche', { 'is-bordel': registre === 'bordel' }]}>
  <h1 class="headline display">{formeFautive}</h1>

  <div class="row">
    <div class="corr">
      <span class="corr-label">{label}</span>
      {
        correctionText ? (
          <b class="display">{correctionText}</b>
        ) : (
          <span class="corr-none">Rien{NBSP}: il n’y a pas d’autre façon de le dire.</span>
        )
      }
      {justification && <p class="why">{justification}</p>}
    </div>

    <div class="side">
      <div class="def"><slot /></div>
    </div>
  </div>

  <footer class="foot">
    {
      sources.length > 0 && (
        <p class="src">
          Source{sources.length > 1 ? 's' : ''}{NBSP}:{' '}
          {sources.map((url) => (
            <a href={url} rel="noopener noreferrer" title={url}>
              {hostOf(url)}
            </a>
          ))}
        </p>
      )
    }
    {
      shoutHref && (
        <a class="plus-fort" href={shoutHref}>
          le dire plus fort
        </a>
      )
    }
    {
      editUrl && (
        <a class="modifier" href={editUrl} rel="noopener noreferrer">
          modifier
        </a>
      )
    }
  </footer>
</article>

<style is:global>
  /* The two footer links: the same quiet rule, next to the fiche they act on. */
  .plus-fort,
  .modifier {
    display: inline-block;
    margin-top: 0.9rem;
    margin-right: 1.1rem;
    font-size: 12px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .plus-fort:hover,
  .modifier:hover {
    color: var(--ink);
  }
</style>
